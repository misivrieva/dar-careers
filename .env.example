# ---- LLM ----
# Provider: openai_compatible (default: Nebius Token Factory) or anthropic
DAR_LLM_PROVIDER=openai_compatible
DAR_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Server-side only. Never commit a real key.
DAR_LLM_API_KEY=
DAR_GENERATION_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Independent judge / validator model (different model family from generation)
DAR_EVAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Only used when DAR_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Storage ----
DAR_DATABASE_URL=sqlite:///storage/dar.db
DAR_STORAGE_DIR=storage
DAR_EMPLOYER_REGISTRY=config/employers.yaml

# ---- Job providers ----
DAR_PROVIDER_TIMEOUT_S=20
DAR_PROVIDER_CONCURRENCY=6
DAR_PROVIDER_MAX_RETRIES=3
DAR_PROVIDER_CACHE_TTL_S=1800

# ---- Agent budgets ----
DAR_AGENT_MAX_TOOL_CALLS=40
DAR_AGENT_MAX_LLM_CALLS=24
DAR_AGENT_MAX_BOARDS=30
DAR_AGENT_TIMEOUT_S=240
DAR_AGENT_TOKEN_BUDGET=400000
DAR_MAX_APPLICATION_ATTEMPTS=3

# ---- Modes ----
# Demo mode uses clearly labelled SYNTHETIC vacancies instead of live boards.
DAR_DEMO_MODE=false
DAR_EVAL_MODE=false
DAR_WORKER_ENABLED=true
DAR_WORKER_POLL_S=1.5
DAR_UPLOAD_MAX_BYTES=5000000
DAR_DATA_RETENTION_DAYS=90
# Paths are relative to the repository root.
# Optional: USD per million tokens, used only for cost estimates in agent runs and eval reports
DAR_LLM_PRICE_IN_PER_MTOK=
DAR_LLM_PRICE_OUT_PER_MTOK=

# ---- Optional job sources (free keys) ----
# Reed UK job search: https://www.reed.co.uk/developers
REED_API_KEY=
# Adzuna UK job search: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Tavily web search, used only by scripts/discover_boards_tavily.py to find careers pages
TAVILY_API_KEY=
